MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=journal
MARIADB_USER=journal
MARIADB_PASSWORD=change-me
# Host port for the db service (loopback only). Default 3307 avoids clashing with a
# native MariaDB already listening on 3306. Not needed at all if nothing on the host
# ever needs to reach the container directly (e.g. most VPS deployments).
DB_HOST_PORT=3307

API_PORT=4300
API_BASE_PATH=/journal-api
ALLOWED_ORIGINS=https://journal.rivierenathan.fr
JOURNAL_ADMIN_PASSWORD=change-me-now
JOURNAL_AUTH_SECRET=replace-with-a-very-long-random-secret
COOKIE_DOMAIN=
BACKUP_KEEP_DAYS=14

VITE_JOURNAL_API_BASE_URL=/journal-api
WEB_DEPLOY_PATH=/var/www/journal
