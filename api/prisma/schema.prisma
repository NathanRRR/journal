generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model JournalEntry {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  tagsJson  String   @default("[]")
  text      String?  @db.Text
  audioUrl  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
